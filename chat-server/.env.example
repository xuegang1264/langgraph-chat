APP_NAME=Chat Server
APP_VERSION=0.1.0
SQLITE_PATH=data/checkpoints.sqlite

# 阿里云百炼 DashScope（设置后 /agent/chat 会调用百炼模型；未设置则保持原有本地回显逻辑）
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_MODEL=qwen-plus

# Token Plan 的 sk-sp- Key 需要使用专属 Base URL
# DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
